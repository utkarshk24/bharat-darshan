  "projects": [
    {
      "id": "sela-tunnel",
      "name": {
        "en": "Sela Tunnel",
        "hi": "सेला सुरंग",
        "mr": "सेला बोगदा",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "Two road tunnels of 1,003 m and 1,595 m, with 8.6 km of approach and link roads, under the Sela Pass at about 13,000 ft on the Balipara–Charduar–Tawang road. Built by the Border Roads Organisation at about ₹825 crore, they give Tawang all-weather road access; the Prime Minister dedicated them to the nation on 9 March 2024.",
        "hi": "बालीपारा–चारद्वार–तवांग सड़क पर लगभग 13,000 फ़ुट पर सेला दर्रे के नीचे 1,003 मीटर और 1,595 मीटर की दो सड़क सुरंगें, 8.6 किमी की पहुँच और संपर्क सड़कों के साथ। सीमा सड़क संगठन ने इन्हें लगभग ₹825 करोड़ में बनाया, और ये तवांग को हर मौसम में सड़क संपर्क देती हैं; प्रधानमंत्री ने 9 मार्च 2024 को इन्हें राष्ट्र को समर्पित किया।",
        "mr": "बालिपारा–चारद्वार–तवांग रस्त्यावर सुमारे 13,000 फूट उंचीवर सेला खिंडीखाली 1,003 मीटर व 1,595 मीटरचे दोन रस्ते बोगदे, 8.6 किमी जोडरस्त्यांसह. सीमा रस्ते संघटनेने ते सुमारे ₹825 कोटी खर्चून बांधले, आणि ते तवांगला सर्व ऋतूंत रस्ते संपर्क देतात; पंतप्रधानांनी 9 मार्च 2024 रोजी ते राष्ट्राला समर्पित केले.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "transport",
      "agency": "Border Roads Organisation",
