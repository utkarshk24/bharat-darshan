  "projects": [
    {
      "id": "mopa-airport",
      "name": {
        "en": "Manohar International Airport, Mopa",
        "hi": "मनोहर अंतरराष्ट्रीय हवाई अड्डा, मोपा",
        "mr": "मनोहर आंतरराष्ट्रीय विमानतळ, मोपा",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "A greenfield international airport at Mopa in Pernem taluka, North Goa, named after former Chief Minister Manohar Parrikar. Its first phase, with a capacity of about 40 lakh passengers a year that can be expanded to about 3.5 crore, was inaugurated by the Prime Minister on 11 December 2022. Goa's older airport at Dabolim, a civil enclave at a naval air station, continues to operate.",
        "hi": "उत्तर गोवा के पेरनेम तालुका के मोपा में नया अंतरराष्ट्रीय हवाई अड्डा, जिसका नाम पूर्व मुख्यमंत्री मनोहर पर्रिकर के नाम पर है। इसके पहले चरण का, जिसकी क्षमता प्रति वर्ष लगभग 40 लाख यात्रियों की है और जिसे लगभग 3.5 करोड़ तक बढ़ाया जा सकता है, प्रधानमंत्री ने 11 दिसंबर 2022 को उद्घाटन किया। नौसेना हवाई स्टेशन पर नागरिक परिसर के रूप में गोवा का पुराना डाबोलिम हवाई अड्डा भी चलता रहता है।",
        "mr": "उत्तर गोव्याच्या पेडणे तालुक्यातील मोपा येथील नवा आंतरराष्ट्रीय विमानतळ, ज्याला माजी मुख्यमंत्री मनोहर पर्रीकर यांचे नाव दिले आहे. वर्षाला सुमारे 40 लाख प्रवासी क्षमतेच्या व सुमारे 3.5 कोटींपर्यंत वाढवता येणाऱ्या त्याच्या पहिल्या टप्प्याचे पंतप्रधानांनी 11 डिसेंबर 2022 रोजी उद्घाटन केले. नौदल हवाई तळावरील नागरी विभाग म्हणून गोव्याचा जुना दाबोळी विमानतळही सुरू आहे.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "aviation",
      "agency": "GMR Goa International Airport Ltd (concessionaire)",
      "start": null,
      "completion": "11 December 2022 (phase 1)",
      "status": "Completed",
      "asOf": "2026-10-24",
      "sourceId": "deccan-herald",
      "url": "https://www.deccanherald.com/amp/story/india%2Fpm-modi-inaugurates-first-phase-of-mopa-international-airport-in-goa-1170718.html",
      "confidence": "Third-party verified"
    }
  ],
