  "projects": [
    {
      "id": "mahsr-gujarat",
      "name": {
        "en": "Mumbai–Ahmedabad High-Speed Rail (Gujarat section)",
        "hi": "मुंबई–अहमदाबाद हाई-स्पीड रेल (गुजरात खंड)",
        "mr": "मुंबई–अहमदाबाद अतिजलद रेल्वे (गुजरात भाग)",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "A 508 km high-speed line, about 90% of it elevated. Eight of its 12 stations — Vapi, Bilimora, Surat, Bharuch, Vadodara, Anand, Ahmedabad and Sabarmati — and 21 of its 25 river bridges are in Gujarat. Track laying on the viaduct began in April 2026; the first service is expected in August 2027.",
        "hi": "508 किमी लंबी हाई-स्पीड लाइन, जिसका लगभग 90% हिस्सा एलिवेटेड है। इसके 12 में से 8 स्टेशन — वापी, बिलिमोरा, सूरत, भरूच, वडोदरा, आणंद, अहमदाबाद और साबरमती — और 25 में से 21 नदी पुल गुजरात में हैं। वायाडक्ट पर पटरी बिछाने का काम अप्रैल 2026 में शुरू हुआ; पहली सेवा अगस्त 2027 में अपेक्षित है।",
        "mr": "508 किमीचा अतिजलद रेल्वेमार्ग, ज्याचा सुमारे 90% भाग उन्नत आहे. त्याच्या 12 पैकी 8 स्थानके — वापी, बिलिमोरा, सुरत, भरूच, वडोदरा, आणंद, अहमदाबाद व साबरमती — आणि 25 पैकी 21 नदीपूल गुजरातमध्ये आहेत. व्हायाडक्टवर रूळ टाकण्याचे काम एप्रिल 2026 मध्ये सुरू झाले; पहिली सेवा ऑगस्ट 2027 मध्ये अपेक्षित आहे.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "transport",
      "agency": "NHSRCL",
      "start": null,
      "completion": "First service expected August 2027",
      "status": "Under Construction",
      "asOf": "2026-10-14",
      "sourceId": "pib",
      "url": "https://www.pib.gov.in/PressReleasePage.aspx?PRID=2272190&lang=1&reg=48",
      "confidence": "Official"
    },
    {
      "id": "dholera-fab",
      "name": {
        "en": "Semiconductor fab, Dholera",
        "hi": "सेमीकंडक्टर फ़ैब, धोलेरा",
        "mr": "सेमीकंडक्टर फॅब, धोलेरा",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "India's first commercial semiconductor fabrication plant, being set up by Tata Electronics in the Dholera Special Investment Region under the Modified Scheme for Semiconductor Fabs. The Prime Minister laid the foundation stone on 13 March 2024, together with an assembly-and-test (OSAT) unit at Sanand.",
        "hi": "भारत का पहला वाणिज्यिक सेमीकंडक्टर फ़ैब्रिकेशन संयंत्र, जिसे टाटा इलेक्ट्रॉनिक्स सेमीकंडक्टर फ़ैब की संशोधित योजना के तहत धोलेरा विशेष निवेश क्षेत्र में बना रही है। प्रधानमंत्री ने 13 मार्च 2024 को इसकी आधारशिला रखी, साथ में साणंद में एक असेंबली-एवं-परीक्षण (ओसैट) इकाई की भी।",
        "mr": "भारतातील पहिला व्यावसायिक सेमीकंडक्टर फॅब्रिकेशन प्रकल्प, जो टाटा इलेक्ट्रॉनिक्स सेमीकंडक्टर फॅबच्या सुधारित योजनेअंतर्गत धोलेरा विशेष गुंतवणूक क्षेत्रात उभारत आहे. पंतप्रधानांनी 13 मार्च 2024 रोजी पायाभरणी केली, सोबत साणंद येथील जुळणी-व-चाचणी (ओसॅट) युनिटचीही.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "industry",
      "agency": "Tata Electronics Private Limited",
      "start": "March 2024",
      "completion": null,
      "status": "Under Construction",
      "asOf": "2026-10-14",
