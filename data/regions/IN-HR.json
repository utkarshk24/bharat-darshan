  "projects": [
    {
      "id": "dwarka-expressway-hr",
      "name": {
        "en": "Dwarka Expressway, Haryana section",
        "hi": "द्वारका एक्सप्रेसवे, हरियाणा खंड",
        "mr": "द्वारका द्रुतगती मार्ग, हरियाणा टप्पा",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "The 19-km, eight-lane Haryana section of the Dwarka Expressway, from the Delhi–Haryana border to Kherki Daula, built in two packages (10.2 km to the Basai rail-over-bridge and 8.7 km on to Kherki Daula) at about ₹4,100 crore. It gives Gurugram direct links to IGI Airport and the Gurugram bypass. Inaugurated by the Prime Minister on 11 March 2024, the same day the foundation stone of the Shamli–Ambala highway was laid.",
        "hi": "द्वारका एक्सप्रेसवे का 19 किमी लंबा आठ-लेन हरियाणा खंड, दिल्ली–हरियाणा सीमा से खेड़की दौला तक, जो लगभग ₹4,100 करोड़ की लागत से दो पैकेज में बना (बसई रेल ओवरब्रिज तक 10.2 किमी और आगे खेड़की दौला तक 8.7 किमी)। यह गुरुग्राम को आईजीआई हवाई अड्डे और गुरुग्राम बाईपास से सीधे जोड़ता है। प्रधानमंत्री ने 11 मार्च 2024 को इसका उद्घाटन किया; उसी दिन शामली–अंबाला राजमार्ग की आधारशिला रखी गई।",
        "mr": "द्वारका द्रुतगती मार्गाचा 19 किमी लांबीचा आठपदरी हरियाणा टप्पा, दिल्ली–हरियाणा सीमेपासून खेडकी दौलापर्यंत, जो सुमारे ₹4,100 कोटी खर्चून दोन पॅकेजमध्ये बांधला गेला (बसई रेल्वे उड्डाणपुलापर्यंत 10.2 किमी व पुढे खेडकी दौलापर्यंत 8.7 किमी). तो गुरुग्रामला आयजीआय विमानतळ व गुरुग्राम बायपासशी थेट जोडतो. पंतप्रधानांनी 11 मार्च 2024 रोजी त्याचे उद्घाटन केले; त्याच दिवशी शामली–अंबाला महामार्गाची पायाभरणी झाली.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
