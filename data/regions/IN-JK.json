  "projects": [
    {
      "id": "usbrl",
      "name": {
        "en": "Udhampur–Srinagar–Baramulla Rail Link",
        "hi": "उधमपुर–श्रीनगर–बारामूला रेल लिंक",
        "mr": "उधमपूर–श्रीनगर–बारामुल्ला रेल्वे मार्ग",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "The railway that links the Kashmir valley with the national network through the Pir Panjal and Chenab gorge, built at a cost of around ₹44,000 crore. It includes the Chenab bridge, described as the world's highest railway arch bridge, and the Anji Khad bridge, India's first cable-stayed rail bridge. Dedicated to the nation by the Prime Minister on 6 June 2025, when two Vande Bharat trains between Shri Mata Vaishno Devi Katra and Srinagar were flagged off.",
        "hi": "वह रेलवे जो पीर पंजाल और चिनाब घाटी से होकर कश्मीर घाटी को राष्ट्रीय नेटवर्क से जोड़ती है, लगभग ₹44,000 करोड़ की लागत से बनी। इसमें दुनिया का सबसे ऊँचा रेलवे आर्च पुल बताया गया चिनाब पुल और भारत का पहला केबल-स्टेड रेल पुल अंजी खड्ड पुल शामिल हैं। प्रधानमंत्री ने 6 जून 2025 को इसे राष्ट्र को समर्पित किया, जब श्री माता वैष्णो देवी कटरा और श्रीनगर के बीच दो वंदे भारत ट्रेनों को हरी झंडी दिखाई गई।",
        "mr": "पीर पंजाल व चिनाबच्या घळीतून काश्मीर खोऱ्याला राष्ट्रीय जाळ्याशी जोडणारी रेल्वे, सुमारे ₹44,000 कोटी खर्चून बांधलेली. तिच्यात जगातील सर्वांत उंच रेल्वे कमान पूल म्हणून वर्णन केलेला चिनाब पूल व भारतातील पहिला केबल-स्टेड रेल्वे पूल अंजी खड्ड पूल यांचा समावेश आहे. पंतप्रधानांनी 6 जून 2025 रोजी ती राष्ट्राला समर्पित केली, तेव्हा श्री माता वैष्णोदेवी कटरा व श्रीनगरदरम्यान दोन वंदे भारत गाड्यांना हिरवा झेंडा दाखवला गेला.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "rail",
