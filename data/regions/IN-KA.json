  "projects": [
    {
      "id": "namma-metro-yellow",
      "name": {
        "en": "Namma Metro Yellow Line (RV Road–Bommasandra)",
        "hi": "नम्मा मेट्रो येलो लाइन (आरवी रोड–बोम्मसंद्रा)",
        "mr": "नम्मा मेट्रो यलो लाईन (आरव्ही रोड–बोम्मसंद्रा)",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "A 19 km elevated line with 16 stations from RV Road (Ragigudda) to Bommasandra, serving the Electronic City technology hub. Part of Bangalore Metro Phase 2; opened by the Prime Minister on 10 August 2025, taking the city's operational metro network past 96 km.",
        "hi": "आरवी रोड (रागीगुड्डा) से बोम्मसंद्रा तक 16 स्टेशनों वाली 19 किमी की एलिवेटेड लाइन, जो इलेक्ट्रॉनिक सिटी प्रौद्योगिकी केंद्र को सेवा देती है। बैंगलोर मेट्रो चरण 2 का हिस्सा; 10 अगस्त 2025 को प्रधानमंत्री ने इसका उद्घाटन किया, जिससे शहर का चालू मेट्रो नेटवर्क 96 किमी से अधिक हो गया।",
        "mr": "आरव्ही रोड (रागीगुड्डा) ते बोम्मसंद्रा अशी 16 स्थानकांची 19 किमीची उन्नत मार्गिका, जी इलेक्ट्रॉनिक सिटी तंत्रज्ञान केंद्राला सेवा देते. बंगळूरु मेट्रो टप्पा 2 चा भाग; 10 ऑगस्ट 2025 रोजी पंतप्रधानांच्या हस्ते उद्घाटन, ज्यामुळे शहरातील कार्यरत मेट्रो जाळे 96 किमीच्या पुढे गेले.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "transport",
      "agency": "Bangalore Metro Rail Corporation Limited (BMRCL)",
