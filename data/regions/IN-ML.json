  "projects": [
    {
      "id": "shillong-silchar-corridor",
      "name": {
        "en": "Shillong–Silchar greenfield high-speed corridor (NH-06)",
        "hi": "शिलांग–सिलचर ग्रीनफ़ील्ड हाई-स्पीड कॉरिडोर (एनएच-06)",
        "mr": "शिलाँग–सिलचर ग्रीनफिल्ड हाय-स्पीड कॉरिडॉर (एनएच-06)",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "A 166.80-km four-lane, access-controlled highway from Mawlyngkhung near Shillong to Panchgram near Silchar in Assam, 144.80 km of it in Meghalaya, approved by the Cabinet Committee on Economic Affairs on 30 April 2025 at a capital cost of ₹22,864 crore under the hybrid annuity mode. It is meant to give a faster, all-weather alternative to the existing hill road through the Jaintia Hills. In March 2026 NHIDCL was inviting bids for its four packages, and the Prime Minister was to lay the foundation stone at Silchar on 14 March 2026.",
        "hi": "शिलांग के पास मावलिंगखुंग से असम में सिलचर के पास पंचग्राम तक 166.80 किमी लंबा चार-लेन, नियंत्रित प्रवेश वाला राजमार्ग, जिसका 144.80 किमी भाग मेघालय में है; आर्थिक मामलों की मंत्रिमंडलीय समिति ने 30 अप्रैल 2025 को हाइब्रिड एन्युटी मोड में ₹22,864 करोड़ की पूँजी लागत पर इसे स्वीकृति दी। इसका उद्देश्य जयंतिया पहाड़ियों से होकर जाने वाली मौजूदा पहाड़ी सड़क का तेज़, हर मौसम में चलने वाला विकल्प देना है। मार्च 2026 में एनएचआईडीसीएल इसके चार पैकेजों के लिए बोलियाँ आमंत्रित कर रहा था, और प्रधानमंत्री को 14 मार्च 2026 को सिलचर में आधारशिला रखनी थी।",
        "mr": "शिलाँगजवळील मावलिंगखुंग ते आसाममधील सिलचरजवळील पंचग्रामपर्यंतचा 166.80 किमी लांबीचा चौपदरी, नियंत्रित प्रवेशाचा महामार्ग, ज्याचा 144.80 किमी भाग मेघालयात आहे; आर्थिक व्यवहार मंत्रिमंडळ समितीने 30 एप्रिल 2025 रोजी हायब्रिड अॅन्युइटी पद्धतीने ₹22,864 कोटी भांडवली खर्चास त्याला मंजुरी दिली. जयंतिया टेकड्यांतून जाणाऱ्या विद्यमान डोंगरी रस्त्याला जलद, सर्व ऋतूंत चालणारा पर्याय देणे हा त्याचा उद्देश आहे. मार्च 2026 मध्ये एनएचआयडीसीएल त्याच्या चार पॅकेजसाठी निविदा मागवत होते, आणि पंतप्रधान 14 मार्च 2026 रोजी सिलचर येथे पायाभरणी करणार होते.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "roads",
      "agency": "NHIDCL (Ministry of Road Transport and Highways)",
      "start": null,
