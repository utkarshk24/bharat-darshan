      "status": "Tendering",
      "asOf": "2026-10-25",
      "sourceId": "swarajya",
      "url": "https://swarajyamag.com/amp/story/news-brief/pm-modi-to-lay-foundation-stone-of-rs-22864-crore-shillong-silchar-corridor-on-14-march-report",
