  "projects": [
    {
      "id": "jiribam-imphal-rail",
      "name": {
        "en": "Jiribam–Imphal new railway line",
        "hi": "जिरीबाम–इंफाल नई रेल लाइन",
        "mr": "जिरीबाम–इंफाळ नवा रेल्वेमार्ग",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "A 111-km (110.625-km) broad-gauge line from Jiribam on the Assam border to Imphal, through Noney district. The 11.8-km Jiribam–Vangaichungpao section opened in February 2017 and the Vangaichungpao–Khongsang section followed; in September 2025 the remaining sections were targeted for March 2026 (Khongsang–Awangkhul), March 2027 (Awangkhul–Noney) and March 2028 (Noney–Imphal). The line has 54 tunnels totalling about 66.5 km, the longest being the 11.55-km Tunnel 12, and the Noney bridge, with a 141-m pier reported as the world's tallest railway pier. In August 2026 Northeast Frontier Railway's General Manager inspected the line, and it was then expected to be fully operational by June 2029.",
        "hi": "असम सीमा पर जिरीबाम से नोनी ज़िले से होकर इंफाल तक 111 किमी (110.625 किमी) लंबी बड़ी लाइन। 11.8 किमी का जिरीबाम–वांगाईचुंगपाओ खंड फरवरी 2017 में खुला और उसके बाद वांगाईचुंगपाओ–खोंगसांग खंड; सितंबर 2025 में शेष खंडों के लक्ष्य मार्च 2026 (खोंगसांग–अवांगखुल), मार्च 2027 (अवांगखुल–नोनी) और मार्च 2028 (नोनी–इंफाल) थे। लाइन में कुल लगभग 66.5 किमी की 54 सुरंगें हैं, जिनमें सबसे लंबी 11.55 किमी की सुरंग 12 है, और नोनी पुल है, जिसके 141 मीटर ऊँचे खंभे को दुनिया का सबसे ऊँचा रेलवे खंभा बताया गया है। अगस्त 2026 में पूर्वोत्तर सीमांत रेलवे के महाप्रबंधक ने लाइन का निरीक्षण किया, और तब इसके जून 2029 तक पूरी तरह चालू होने की उम्मीद थी।",
        "mr": "आसाम सीमेवरील जिरीबामपासून नोनी जिल्ह्यातून इंफाळपर्यंतचा 111 किमी (110.625 किमी) लांबीचा ब्रॉडगेज मार्ग. 11.8 किमीचा जिरीबाम–वांगाईचुंगपाओ टप्पा फेब्रुवारी 2017 मध्ये सुरू झाला आणि त्यानंतर वांगाईचुंगपाओ–खोंगसांग टप्पा; सप्टेंबर 2025 मध्ये उर्वरित टप्प्यांचे उद्दिष्ट मार्च 2026 (खोंगसांग–अवांगखुल), मार्च 2027 (अवांगखुल–नोनी) आणि मार्च 2028 (नोनी–इंफाळ) होते. मार्गात एकूण सुमारे 66.5 किमीचे 54 बोगदे आहेत, त्यांपैकी सर्वांत लांब 11.55 किमीचा बोगदा 12 आहे, आणि नोनी पूल आहे, ज्याचा 141 मीटर उंच खांब जगातील सर्वांत उंच रेल्वे खांब असल्याचे सांगितले जाते. ऑगस्ट 2026 मध्ये ईशान्य सीमा रेल्वेच्या महाव्यवस्थापकांनी मार्गाची पाहणी केली, आणि तेव्हा तो जून 2029 पर्यंत पूर्णपणे कार्यान्वित होणे अपेक्षित होते.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "railways",
      "agency": "Northeast Frontier Railway",
      "start": null,
      "completion": "June 2029 (target)",
      "status": "Under Construction",
      "asOf": "2026-10-28",
      "sourceId": "pib",
