  "projects": [
    {
      "id": "jiribam-imphal-rail",
      "name": {
        "en": "Jiribam–Imphal new railway line",
        "hi": "जिरीबाम–इंफाल नई रेल लाइन",
        "mr": "जिरीबाम–इंफाळ नवा रेल्वेमार्ग",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "A 111-km broad-gauge line from Jiribam on the Assam border to Imphal through the hills of Noney and Tamenglong, with 54 tunnels totalling about 66.5 km — the longest, Tunnel 12, is 11.55 km — and the Noney bridge, whose 141-m piers Northeast Frontier Railway describes as the tallest railway piers in the world. The estimated cost is about ₹22,000 crore. In August 2026 NFR officials inspected the Jiribam–Khongsang, Khongsang–Awangkhul and Awangkhul–Imphal sections, and the line is targeted to reach Imphal by June 2029.",
        "hi": "असम सीमा पर जिरीबाम से नोनी और तामेंगलोंग की पहाड़ियों से होकर इंफाल तक 111 किमी लंबी बड़ी लाइन, जिसमें कुल लगभग 66.5 किमी की 54 सुरंगें हैं — सबसे लंबी, सुरंग 12, 11.55 किमी की है — और नोनी पुल, जिसके 141 मीटर ऊँचे खंभों को पूर्वोत्तर सीमांत रेलवे दुनिया के सबसे ऊँचे रेलवे खंभे बताता है। अनुमानित लागत लगभग ₹22,000 करोड़ है। अगस्त 2026 में एनएफ़आर अधिकारियों ने जिरीबाम–खोंगसांग, खोंगसांग–अवांगखुल और अवांगखुल–इंफाल खंडों का निरीक्षण किया, और जून 2029 तक लाइन को इंफाल पहुँचाने का लक्ष्य है।",
        "mr": "आसाम सीमेवरील जिरीबामपासून नोनी व तामेंगलोंगच्या डोंगरांतून इंफाळपर्यंतचा 111 किमी लांबीचा ब्रॉडगेज मार्ग, ज्यात एकूण सुमारे 66.5 किमीचे 54 बोगदे आहेत — सर्वांत लांब, बोगदा 12, 11.55 किमीचा आहे — आणि नोनी पूल, ज्याच्या 141 मीटर उंच खांबांना ईशान्य सीमा रेल्वे जगातील सर्वांत उंच रेल्वे खांब म्हणते. अंदाजित खर्च सुमारे ₹22,000 कोटी आहे. ऑगस्ट 2026 मध्ये एनएफआर अधिकाऱ्यांनी जिरीबाम–खोंगसांग, खोंगसांग–अवांगखुल व अवांगखुल–इंफाळ टप्प्यांची पाहणी केली, आणि जून 2029 पर्यंत मार्ग इंफाळला पोहोचवण्याचे उद्दिष्ट आहे.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "railways",
      "agency": "Northeast Frontier Railway",
      "start": null,
      "completion": "June 2029 (target)",
      "status": "Under Construction",
      "asOf": "2026-10-25",
      "sourceId": "morung-express",
      "url": "https://morungexpress.com/imphal-to-become-fifth-northeast-capital-city-on-national-railway-map-by-june-2029",
      "confidence": "Third-party verified",
      "cost": {
        "value": 22000,
        "unit": "₹ crore",
        "period": "2026",
        "periodType": "calendar",
        "sourceId": "morung-express",
        "url": "https://morungexpress.com/imphal-to-become-fifth-northeast-capital-city-on-national-railway-map-by-june-2029",
        "accessDate": "2026-10-25",
        "dataLevel": "state",
