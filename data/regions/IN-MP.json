  "projects": [
    {
      "id": "ken-betwa",
      "name": {
        "en": "Ken–Betwa river link project",
        "hi": "केन–बेतवा नदी जोड़ परियोजना",
        "mr": "केन–बेतवा नदीजोड प्रकल्प",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "The first project under the national river-linking plan, transferring water from the Ken to the Betwa basin through the Daudhan dam and a link canal. It is meant to irrigate more than 8 lakh hectares in 10 districts of Madhya Pradesh and over 2.5 lakh hectares in Uttar Pradesh, supply drinking water to about 65 lakh people, and add 103 MW of hydro and 27 MW of solar power. The Prime Minister laid the foundation stone at Khajuraho on 25 December 2024.",
        "hi": "राष्ट्रीय नदी-जोड़ योजना की पहली परियोजना, जो दौधन बाँध और लिंक नहर से केन का पानी बेतवा बेसिन में ले जाएगी। इसका उद्देश्य मध्य प्रदेश के 10 ज़िलों में 8 लाख हेक्टेयर से अधिक और उत्तर प्रदेश में 2.5 लाख हेक्टेयर से अधिक की सिंचाई, लगभग 65 लाख लोगों को पेयजल, और 103 मेगावाट जलविद्युत व 27 मेगावाट सौर बिजली है। प्रधानमंत्री ने 25 दिसंबर 2024 को खजुराहो में इसकी आधारशिला रखी।",
        "mr": "राष्ट्रीय नदीजोड योजनेतील पहिला प्रकल्प, जो दौधन धरण व जोड कालव्यातून केनचे पाणी बेतवा खोऱ्यात नेईल. मध्य प्रदेशच्या 10 जिल्ह्यांत 8 लाख हेक्टरहून अधिक व उत्तर प्रदेशात 2.5 लाख हेक्टरहून अधिक सिंचन, सुमारे 65 लाख लोकांना पिण्याचे पाणी, आणि 103 मेगावॅट जलविद्युत व 27 मेगावॅट सौरऊर्जा हा उद्देश आहे. पंतप्रधानांनी 25 डिसेंबर 2024 रोजी खजुराहो येथे पायाभरणी केली.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
