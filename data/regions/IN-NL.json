  "projects": [
    {
      "id": "dimapur-kohima-rail",
      "name": {
        "en": "Dhansiri (Dimapur)–Zubza (Kohima) new railway line",
        "hi": "धनसिरी (दीमापुर)–ज़ुबज़ा (कोहिमा) नई रेल लाइन",
        "mr": "धनसिरी (दिमापूर)–झुबझा (कोहिमा) नवा रेल्वेमार्ग",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "A 78.42-km broad-gauge line from Dhansiri near Dimapur to Zubza near Kohima, through Assam's Karbi Anglong and Nagaland's Chümoukedima and Kohima districts, which will bring the railway to the State capital. The 16.5-km Dhansiri–Shokhuvi section opened in October 2021 and the 14.64-km Shokhuvi–Molvom section in March 2025; 20 tunnels and 27 major bridges remained, and Northeast Frontier Railway targets completion by 2029.",
        "hi": "दीमापुर के पास धनसिरी से कोहिमा के पास ज़ुबज़ा तक 78.42 किमी लंबी बड़ी लाइन, जो असम के कार्बी आंगलोंग और नागालैंड के चुमौकेदिमा और कोहिमा ज़िलों से गुज़रेगी और राज्य की राजधानी तक रेल लाएगी। 16.5 किमी का धनसिरी–शोखुवी खंड अक्टूबर 2021 में और 14.64 किमी का शोखुवी–मोलवोम खंड मार्च 2025 में खुला; 20 सुरंगें और 27 बड़े पुल शेष थे, और पूर्वोत्तर सीमांत रेलवे ने 2029 तक पूरा करने का लक्ष्य रखा है।",
        "mr": "दिमापूरजवळील धनसिरी ते कोहिमाजवळील झुबझापर्यंतचा 78.42 किमी लांबीचा ब्रॉडगेज मार्ग, जो आसाममधील कार्बी आंगलोंग व नागालँडमधील चुमौकेदिमा आणि कोहिमा जिल्ह्यांतून जाईल व राज्याच्या राजधानीपर्यंत रेल्वे आणेल. 16.5 किमीचा धनसिरी–शोखुवी टप्पा ऑक्टोबर 2021 मध्ये व 14.64 किमीचा शोखुवी–मोलवोम टप्पा मार्च 2025 मध्ये सुरू झाला; 20 बोगदे व 27 मोठे पूल बाकी होते, आणि ईशान्य सीमा रेल्वेने 2029 पर्यंत पूर्णत्वाचे उद्दिष्ट ठेवले आहे.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "railways",
      "agency": "Northeast Frontier Railway",
      "start": null,
      "completion": "2029 (target)",
      "status": "Under Construction",
      "asOf": "2026-10-25",
      "sourceId": "morung-express",
      "url": "https://morungexpress.com/railways-target-2029-completion-of-dimapurkohima-line",
      "confidence": "Third-party verified"
    }
