  "projects": [
    {
      "id": "sicsem-fab",
      "name": {
        "en": "SiCSem silicon-carbide semiconductor unit, Bhubaneswar",
        "hi": "सिकसेम सिलिकॉन कार्बाइड सेमीकंडक्टर इकाई, भुवनेश्वर",
        "mr": "सिकसेम सिलिकॉन कार्बाइड सेमीकंडक्टर प्रकल्प, भुवनेश्वर",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "A compound-semiconductor fabrication unit at Info Valley, Bhubaneswar, with technology from Clas-SiC Wafer Fab of the UK — described by the Union Cabinet as the country's first commercial compound fab — with planned capacity of 60,000 wafers and 96 million packaged units a year.",
        "hi": "भुवनेश्वर की इन्फ़ो वैली में ब्रिटेन की क्लास-एसआईसी वेफ़र फ़ैब की तकनीक से कंपाउंड सेमीकंडक्टर निर्माण इकाई — केंद्रीय मंत्रिमंडल के अनुसार देश की पहली व्यावसायिक कंपाउंड फ़ैब — जिसकी नियोजित क्षमता प्रति वर्ष 60,000 वेफ़र और 9.6 करोड़ पैकेज्ड इकाइयाँ है।",
        "mr": "भुवनेश्वरच्या इन्फो व्हॅलीत ब्रिटनच्या क्लास-एसआयसी वेफर फॅबच्या तंत्रज्ञानाने उभारला जाणारा कंपाउंड सेमीकंडक्टर निर्मिती प्रकल्प — केंद्रीय मंत्रिमंडळानुसार देशातील पहिली व्यावसायिक कंपाउंड फॅब — ज्याची नियोजित क्षमता दरवर्षी 60,000 वेफर्स व 9.6 कोटी पॅकेज्ड युनिट्स आहे.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "industry",
      "agency": "SiCSem Private Limited (India Semiconductor Mission)",
      "start": "Approved 12 August 2025",
      "completion": null,
      "status": "Announced",
      "asOf": "2026-10-16",
      "sourceId": "pmindia",
      "url": "https://www.pmindia.gov.in/en/news_updates/cabinet-approves-semiconductor-manufacturing-units-in-odisha-punjab-and-andhra-pradesh-with-an-outlay-of-rs-4600-crore",
      "confidence": "Official"
    },
    {
      "id": "3dgs-packaging",
      "name": {
        "en": "3D Glass Solutions advanced packaging unit, Bhubaneswar",
        "hi": "3डी ग्लास सॉल्यूशंस उन्नत पैकेजिंग इकाई, भुवनेश्वर",
        "mr": "3डी ग्लास सोल्यूशन्स प्रगत पॅकेजिंग प्रकल्प, भुवनेश्वर",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "An advanced semiconductor packaging and embedded glass-substrate unit at Info Valley, approved together with the SiCSem unit. The Cabinet gave a combined investment of about ₹4,600 crore for the four units approved that day in Odisha, Punjab and Andhra Pradesh, without a break-up by unit.",
        "hi": "इन्फ़ो वैली में उन्नत सेमीकंडक्टर पैकेजिंग और एम्बेडेड ग्लास-सब्सट्रेट इकाई, जिसे सिकसेम इकाई के साथ मंज़ूरी मिली। मंत्रिमंडल ने उस दिन ओडिशा, पंजाब और आंध्र प्रदेश में मंज़ूर चार इकाइयों के लिए लगभग ₹4,600 करोड़ का संयुक्त निवेश बताया, इकाईवार विभाजन के बिना।",
        "mr": "इन्फो व्हॅलीतील प्रगत सेमीकंडक्टर पॅकेजिंग व एम्बेडेड काच-सब्सट्रेट प्रकल्प, ज्याला सिकसेम प्रकल्पासोबत मंजुरी मिळाली. मंत्रिमंडळाने त्या दिवशी ओडिशा, पंजाब व आंध्र प्रदेशात मंजूर केलेल्या चार प्रकल्पांसाठी सुमारे ₹4,600 कोटींची एकत्रित गुंतवणूक सांगितली, प्रकल्पनिहाय विभागणीशिवाय.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "industry",
      "agency": "3D Glass Solutions Inc. (India Semiconductor Mission)",
      "start": "Approved 12 August 2025",
      "completion": null,
      "status": "Announced",
      "asOf": "2026-10-16",
