  "projects": [
    {
      "id": "aiims-bathinda",
      "name": {
        "en": "AIIMS Bathinda",
        "hi": "एम्स बठिंडा",
        "mr": "एम्स भटिंडा",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "Punjab's All India Institute of Medical Sciences at Bathinda, dedicated to the nation by the Prime Minister on 25 February 2024 together with AIIMS Rajkot, Raebareli, Mangalagiri and Kalyani. The same day a 300-bed PGIMER satellite centre at Sangrur was dedicated and the foundation stone of a 100-bed centre at Ferozepur laid.",
        "hi": "बठिंडा में पंजाब का अखिल भारतीय आयुर्विज्ञान संस्थान, जिसे प्रधानमंत्री ने 25 फ़रवरी 2024 को एम्स राजकोट, रायबरेली, मंगलगिरि और कल्याणी के साथ राष्ट्र को समर्पित किया। उसी दिन संगरूर में पीजीआईएमईआर का 300 बिस्तरों वाला उपग्रह केंद्र समर्पित किया गया और फ़िरोज़पुर में 100 बिस्तरों वाले केंद्र की आधारशिला रखी गई।",
        "mr": "भटिंडा येथील पंजाबचे अखिल भारतीय आयुर्विज्ञान संस्थान, जे पंतप्रधानांनी 25 फेब्रुवारी 2024 रोजी एम्स राजकोट, रायबरेली, मंगलगिरी व कल्याणीसोबत राष्ट्राला समर्पित केले. त्याच दिवशी संगरूर येथील पीजीआयएमईआरचे 300 खाटांचे उपकेंद्र समर्पित करण्यात आले व फिरोजपूर येथील 100 खाटांच्या केंद्राची पायाभरणी झाली.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
