  "projects": [
    {
      "id": "pakyong-airport",
      "name": {
        "en": "Pakyong Airport",
        "hi": "पाक्योंग हवाई अड्डा",
        "mr": "पाकयोंग विमानतळ",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "Sikkim's first airport, at Pakyong about 30 km from Gangtok, inaugurated by the Prime Minister on 24 September 2018 as India's 100th airport and part of the UDAN regional connectivity scheme. Before it, the nearest airport was Bagdogra in West Bengal, a four-hour drive away. Flights have been irregular because of the hill-top runway and frequent low cloud.",
        "hi": "पाक्योंग में, गंगटोक से लगभग 30 किमी दूर, सिक्किम का पहला हवाई अड्डा, जिसका प्रधानमंत्री ने 24 सितंबर 2018 को देश के 100वें हवाई अड्डे और उड़ान क्षेत्रीय संपर्क योजना के भाग के रूप में उद्घाटन किया। इससे पहले निकटतम हवाई अड्डा पश्चिम बंगाल का बागडोगरा था, जो चार घंटे की दूरी पर है। पहाड़ी पर बने रनवे और बार-बार नीचे छाए बादलों के कारण उड़ानें अनियमित रही हैं।",
        "mr": "पाकयोंग येथे, गंगटोकपासून सुमारे 30 किमी, सिक्कीमचा पहिला विमानतळ, ज्याचे पंतप्रधानांनी 24 सप्टेंबर 2018 रोजी देशाचा 100 वा विमानतळ व उडान प्रादेशिक संपर्क योजनेचा भाग म्हणून उद्घाटन केले. त्यापूर्वी जवळचा विमानतळ पश्चिम बंगालमधील बागडोगरा होता, चार तासांच्या अंतरावर. डोंगरमाथ्यावरील धावपट्टी व वारंवार खाली येणाऱ्या ढगांमुळे उड्डाणे अनियमित राहिली आहेत.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "aviation",
      "agency": "Airports Authority of India",
      "start": null,
      "completion": "24 September 2018",
      "status": "Completed",
      "asOf": "2026-10-25",
      "sourceId": "pmindia",
      "url": "https://www.pmindia.gov.in/en/news_updates/pm-inaugurates-pakyong-airport-as-air-connectivity-reaches-sikkim/",
      "confidence": "Official"
    },
    {
      "id": "sivok-rangpo-rail",
      "name": {
        "en": "Sivok–Rangpo new railway line",
        "hi": "सेवक–रंगपो नई रेल लाइन",
        "mr": "सेवक–रंगपो नवा रेल्वेमार्ग",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "A 44.96-km broad-gauge line from Sivok in West Bengal to Rangpo on the Sikkim border, with tunnels and bridges along its route, which will give Sikkim its first rail link. PIB's factsheet of September 2025 gave December 2027 as the target; in June 2026 IRCON told a visiting parliamentary committee that physical progress was 77% and that the target was unchanged.",
        "hi": "पश्चिम बंगाल के सेवक से सिक्किम सीमा पर रंगपो तक 44.96 किमी लंबी बड़ी लाइन, जिसके रास्ते में सुरंगें और पुल हैं, और जो सिक्किम को पहला रेल संपर्क देगी। सितंबर 2025 के पीआईबी तथ्यपत्र में लक्ष्य दिसंबर 2027 बताया गया; जून 2026 में इरकॉन ने दौरे पर आई एक संसदीय समिति को बताया कि भौतिक प्रगति 77% थी और लक्ष्य वही है।",
        "mr": "पश्चिम बंगालमधील सेवक ते सिक्कीम सीमेवरील रंगपोपर्यंतचा 44.96 किमी लांबीचा ब्रॉडगेज मार्ग, ज्याच्या मार्गावर बोगदे व पूल आहेत आणि जो सिक्कीमला पहिला रेल्वे संपर्क देईल. सप्टेंबर 2025 च्या पीआयबी तथ्यपत्रात उद्दिष्ट डिसेंबर 2027 सांगितले होते; जून 2026 मध्ये इरकॉनने भेटीला आलेल्या संसदीय समितीला सांगितले की भौतिक प्रगती 77% होती आणि उद्दिष्ट तेच आहे.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
