  "projects": [
    {
      "id": "rishikesh-karnaprayag",
      "name": {
        "en": "Rishikesh–Karnaprayag new rail line",
        "hi": "ऋषिकेश–कर्णप्रयाग नई रेल लाइन",
        "mr": "ऋषिकेश–कर्णप्रयाग नवीन रेल्वे मार्गिका",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "A 125-km broad-gauge railway from Rishikesh into the Garhwal hills to Karnaprayag, most of it in tunnels. In a written reply to the Lok Sabha reported in August 2025, the Railway Minister said 199 km of the 213 km of tunnelling was complete — 13 of 16 main-line tunnels and 9 of 12 escape tunnels — and that an exact completion date could not yet be fixed.",
        "hi": "ऋषिकेश से गढ़वाल की पहाड़ियों में कर्णप्रयाग तक 125 किमी लंबी ब्रॉड गेज रेलवे, जिसका अधिकांश भाग सुरंगों में है। अगस्त 2025 में प्रकाशित लोकसभा में लिखित उत्तर में रेल मंत्री ने बताया कि 213 किमी सुरंग कार्य में से 199 किमी पूरा हो चुका है — 16 में से 13 मुख्य सुरंगें और 12 में से 9 निकास सुरंगें — और पूरा होने की सटीक तिथि अभी तय नहीं की जा सकती।",
        "mr": "ऋषिकेशहून गढवालच्या डोंगरांत कर्णप्रयागपर्यंतची 125 किमी लांबीची ब्रॉड गेज रेल्वे, जिचा बहुतांश भाग बोगद्यांत आहे. ऑगस्ट 2025 मध्ये प्रसिद्ध झालेल्या लोकसभेतील लेखी उत्तरात रेल्वेमंत्र्यांनी सांगितले की 213 किमी बोगदा कामापैकी 199 किमी पूर्ण झाले आहे — 16 पैकी 13 मुख्य बोगदे व 12 पैकी 9 सुटका बोगदे — आणि पूर्ण होण्याची नेमकी तारीख अजून ठरवता येत नाही.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "sector": "rail",
      "agency": "Rail Vikas Nigam Ltd (Ministry of Railways)",
      "start": null,
      "completion": null,
      "status": "Under Construction",
      "asOf": "2026-10-24",
      "sourceId": "etv-bharat",
      "url": "https://www.etvbharat.com/en/!bharat/no-timeline-set-for-completion-of-rishikesh-karnaprayag-rail-line-vaishnaw-enn25080703839",
      "confidence": "Third-party verified"
    },
    {
      "id": "kedarnath-ropeway",
      "name": {
        "en": "Sonprayag–Kedarnath and Govindghat–Hemkund Sahib ropeways",
        "hi": "सोनप्रयाग–केदारनाथ और गोविंदघाट–हेमकुंड साहिब रोपवे",
        "mr": "सोनप्रयाग–केदारनाथ व गोविंदघाट–हेमकुंड साहिब रोपवे",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
      "objective": {
        "en": "Two ropeways approved by the Union Cabinet on 5 March 2025: a 12.9-km line from Sonprayag to Kedarnath costing over ₹4,000 crore, which would cut the climb of 8–9 hours to about 36 minutes, and a 12.4-km line from Govindghat to Hemkund Sahib costing ₹2,730 crore.",
        "hi": "5 मार्च 2025 को केंद्रीय मंत्रिमंडल द्वारा स्वीकृत दो रोपवे: सोनप्रयाग से केदारनाथ तक 12.9 किमी लंबी लाइन, जिसकी लागत ₹4,000 करोड़ से अधिक है और जो 8–9 घंटे की चढ़ाई को लगभग 36 मिनट कर देगी, और गोविंदघाट से हेमकुंड साहिब तक ₹2,730 करोड़ की 12.4 किमी लंबी लाइन।",
        "mr": "5 मार्च 2025 रोजी केंद्रीय मंत्रिमंडळाने मंजूर केलेले दोन रोपवे: सोनप्रयागहून केदारनाथपर्यंतची 12.9 किमी लांबीची मार्गिका, जिचा खर्च ₹4,000 कोटींहून अधिक असून ती 8–9 तासांची चढण सुमारे 36 मिनिटांवर आणेल, आणि गोविंदघाटहून हेमकुंड साहिबपर्यंतची ₹2,730 कोटींची 12.4 किमी मार्गिका.",
        "_status": {
          "hi": "draft",
          "mr": "draft"
        }
      },
